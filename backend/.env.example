# Database Configuration
DATABASE_URL=sqlite:///smartgov.db

# Application Security
SECRET_KEY=default-secret-key

# Vendor Default Configs
VENDOR_DEFAULT_SPECIALIZATION=Infrastructure
VENDOR_AUTO_VERIFY=true
VENDOR_SUPPORT_EMAIL=vendor-support@smartgov.in

# Mailer Service Configs (Used by server.js / SMTP / OTP)
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SERVER=smtp.gmail.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@smartgov.insight
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@smartgov.insight
